root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = block_scoped
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

[*.{py,sh}]
indent_style = space
indent_size = 4

[*.{json,asmdef,md}]
indent_style = space
indent_size = 4
